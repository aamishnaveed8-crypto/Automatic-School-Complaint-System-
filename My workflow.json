        -368
      ],
      "id": "eb136273-1100-4de6-afee-7155db857e99",
      "name": "Complaint Id Generator"
    },
    {
      "parameters": {
        "jsCode": "// Map categories to email addresses\nconst emailMap = {\n  \"Fee Issue\": \"aamishnaveed8@gmail.com\",\n  \"Teacher Behavior\": \"aamishnaveed703@gmail.com\",\n  \"Discipline\": \"aamishnaveed8@gmail.com\",\n  \"Technical Problem\": \"aamishnaveed703@gmail.com\",\n  \"Maintenance\": \"aamishtagga@gmail.com\",\n  \"Other\": \"aamishtagga@gmail.com\"   // default\n};\n\nreturn items.map(item => {\n  const data = item.json;\n\n  return {\n    json: {\n      ...data,  // ⬅️ Keep ALL Google Sheet fields without losing anything\n      to: emailMap[data[\"Optional Category\"]] || \"aamishtagga@gmail.com\"\n    }\n  };\n});\n"
      },
